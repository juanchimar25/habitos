# Bloquea los scripts de ciclo de vida (preinstall / install / postinstall) de
# TODOS los paquetes, propios y transitivos.
#
# Es la vía por la que funcionan casi todos los ataques de cadena de suministro
# de npm: el paquete comprometido no espera a que lo importes, corre en cuanto
# lo instalás y se lleva variables de entorno, tokens de npm, claves SSH y
# credenciales de nube de la máquina que instaló.
#
# Acá no cuesta nada: hoy ningún paquete del árbol necesita ejecutar scripts al
# instalar, y está verificado que `npm ci --ignore-scripts` deja jsdom
# funcionando. Si algún día una dependencia lo necesitara de verdad, va a
# fallar de forma visible en vez de ejecutar en silencio — que es exactamente
# el compromiso que se quiere.
ignore-scripts=true

# Los avisos de financiación son ruido; la auditoría NO se toca. `npm ci`
# audita solo al instalar, y ese aviso es justamente lo que se quiere ver.
fund=false
